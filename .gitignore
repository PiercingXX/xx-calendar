# ─── Calendar data ───────────────────────────────────────────────────────
# An .ics export is every appointment you have ever had. Never commit one.
*.ics
*.ical
*.ifb
backup*.json
export*/

# ─── Secrets ─────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
secrets/
*.pem
*.key
# Never commit signing material — no exceptions. Debug builds use the
# default auto-generated ~/.android/debug.keystore.
*.keystore
*.jks
# Release signing material (storeFile/storePassword/keyAlias/keyPassword).
keystore.properties

# ─── Android ─────────────────────────────────────────────────────────────
local.properties
.gradle/
build/
captures/
.externalNativeBuild/
.cxx/
*.apk
*.aab
*.iml
.idea/

# ─── OS ──────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp

# Skippy runtime bookkeeping — never tracked
.skippy/

# Estate mill/audit scratch — never tracked
.nagatha/
.bilby/

# Mill-seeded venv is a house symlink or share dir — never tracked
.venv
