# ─── Calendar data ───────────────────────────────────────────────────────
# An .ics export is every appointment you have ever had. Never commit one.
*.ics
*.ical
*.ifb
backup*.json
export*/

# ─── Secrets ─────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
secrets/
*.pem
*.key
# Never commit signing material — the shared debug keystore is the one
# deliberate exception (mirrors nope-mode; see NOTICE and review P1).
*.keystore
!debug.keystore
# Release signing material (storeFile/storePassword/keyAlias/keyPassword).
keystore.properties

# ─── Android ─────────────────────────────────────────────────────────────
local.properties
.gradle/
build/
captures/
.externalNativeBuild/
.cxx/
*.apk
*.aab
*.iml
.idea/

# ─── OS ──────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp

# Skippy runtime bookkeeping — never tracked
.skippy/
